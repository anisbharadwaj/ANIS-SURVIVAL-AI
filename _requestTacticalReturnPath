if (response.statusCode == 200) {
        final Map<String, dynamic> data = jsonDecode(response.body);
        final List<dynamic> coords = data['coordinates'];

        setState(() {
          _navigationPath = coords.map((c) => LatLng(c['latitude'], c['longitude'])).toList();
          _engineStatus = "ROUTE_READY";
        });

        // Trigger Offline Audio Guidance Broadcast
        if (_navigationPath.isNotEmpty) {
          _mapController.move(_navigationPath.first, 14.5);
          
          // Tactical voice readout
          VoiceEngine.instance.speakTacticalAlert(
            "Navigation path calculated successfully. Heading to base camp via route variant: $mode."
          );
        }
      } else {
        setState(() => _engineStatus = "MESH_OUT_OF_BOUNDS");
        VoiceEngine.instance.speakTacticalAlert("Alert. Destination outside local mesh telemetry.");
      }
