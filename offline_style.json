{
  "version": 8,
  "name": "AnisSurvivalOfflineStyle",
  "sources": {
    "local-osm-tiles": {
      "type": "vector",
      "tiles": [
        "asset://assets/maps/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#020204" }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "local-osm-tiles",
      "source-layer": "transportation",
      "paint": { "line-color": "#00F0FF", "line-width": 1.5 }
    }
  ]
}
